# Entorno de la base LOCAL (ADR-17). Se copia a `.env.test`:
#
#     cp .env.test.example .env.test
#
# `.env.test` es lo que leen `pnpm seed:demo`, `pnpm test:security` y
# `pnpm test:security:drill`. NUNCA leen `.env.local`, que apunta a producción.
#
# Los valores de Supabase son los de `supabase start`: son fijos, públicos y
# los mismos en cualquier máquina. No son secretos, y por eso este fichero de
# ejemplo puede llevarlos completos. Compruébalos con `pnpm db:status` si tu
# CLI los cambia.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Talpass
NEXT_PUBLIC_ALLOW_INDEXING=false

# Llavero de la base local. Cifra datos de demostración, así que no protege
# nada: no reutilices estas claves en ningún otro entorno, ni las de producción
# aquí. Generar unas nuevas:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
TALPASS_ENCRYPTION_KEYS=k1:zeQVVwxJ8Yk4LgIt+z1dMI4D8rttB96K1NJ+OKlGsE0=
TALPASS_ENCRYPTION_ACTIVE_KEY_ID=k1
TALPASS_BLIND_INDEX_KEY=b/bI1Flm41a+mmR137pDOM4yMlOHyYWw3UuLtQ8B+cY=
