# Copia este fichero a .env.local y rellena los valores reales.
# .env.local está en .gitignore y NUNCA se commitea.
#
# ⚠️ Este fichero es el de PRODUCCIÓN. Para desarrollar y para los tests se usa
# `.env.test`, que apunta a la base local (ADR-17):
#
#     cp .env.test.example .env.test
#
# Lo leen `pnpm dev:local`, `seed:demo`, `test:security` y el simulacro. Sus
# valores no son secretos: son los fijos de `supabase start`.

# --- Supabase (región EU / Frankfurt — ADR-09) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA se expone al cliente. Solo en Server Actions, route handlers y scripts de admin.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a Postgres. Solo para la CLI de Supabase y para los
# tests de seguridad; nunca la usa la aplicación.
SUPABASE_DB_URL=

# TALPASS_ALLOW_PRODUCTION_WRITES no aparece aquí a propósito (ADR-17). Es la
# salida de emergencia que deja a `seed:demo` y al simulacro de brecha escribir
# contra un destino remoto. Se teclea en la línea de esa ejecución concreta y
# nunca se guarda en un fichero: en un `.env` dejaría de ser una decisión.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Marca provisional (ADR-12): se cambia aquí, no en el código.
NEXT_PUBLIC_SITE_NAME=Talpass

# Indexación. Se abre en la fase 3, y SOLO en producción con dominio definitivo.
# Cualquier otro valor (o ausencia) => robots.txt devuelve "Disallow: /".
# No se deriva de VERCEL_ENV ni del host a propósito: ver src/app/robots.ts.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Cifrado de datos sensibles (ADR-15) ---
# Llavero: "id:clave-base64" separados por comas. La clave es de 32 bytes.
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# NUNCA se expone al cliente. Perder estas claves = perder los IBAN cifrados.
TALPASS_ENCRYPTION_KEYS=
# Identificador de la clave con la que se CIFRA hoy. Las demás solo descifran.
TALPASS_ENCRYPTION_ACTIVE_KEY_ID=k1
# Clave independiente del índice ciego (HMAC) que detecta identificadores
# fiscales duplicados sin guardarlos en claro. 32 bytes en base64.
TALPASS_BLIND_INDEX_KEY=

# --- Email (fase 8) ---
RESEND_API_KEY=
EMAIL_FROM=
